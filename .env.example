# Required
YOUTUBE_API_KEY=
GEMINI_API_KEY=                # aistudio.google.com/apikey — all LLM calls
GROQ_API_KEY=                  # console.groq.com — only for transcribing uploaded audio (Whisper)

# Optional overrides (defaults shown)
# DATABASE_URL=postgresql+pg8000://brain:brain@localhost:5433/brain
# LLM_MODEL=gemini-3.5-flash-lite          # answers, drift, composer, per-video analysis
# LLM_FAST_MODEL=gemini-3.5-flash-lite     # promise verification
# WHISPER_MODEL=whisper-large-v3-turbo     # uploaded audio (Groq)
# MAX_VIDEOS=50
# TRANSCRIPT_PROXY=http://user:pass@host:port   # if YouTube blocks transcript requests from your IP

# LangSmith tracing (optional) — see every agent, tool call and indexing step at smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_your_key_here
# LANGSMITH_PROJECT=creator-second-brain
