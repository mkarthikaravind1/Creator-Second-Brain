# Required
YOUTUBE_API_KEY=
GROQ_API_KEY=

# Optional overrides (defaults shown)
# DATABASE_URL=postgresql+pg8000://brain:brain@localhost:5433/brain
# LLM_MODEL=openai/gpt-oss-120b            # answers, drift, composer, per-video analysis
# LLM_FAST_MODEL=openai/gpt-oss-20b        # promise verification
# WHISPER_MODEL=whisper-large-v3-turbo     # uploaded audio
# MAX_VIDEOS=50
# TRANSCRIPT_PROXY=http://user:pass@host:port   # if YouTube blocks transcript requests from your IP

# LangSmith tracing (optional) — see every agent, tool call and indexing step at smith.langchain.com
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_your_key_here
# LANGSMITH_PROJECT=creator-second-brain
